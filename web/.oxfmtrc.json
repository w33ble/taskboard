{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "insertFinalNewline": true,
  "sortPackageJson": false,
  "ignorePatterns": ["node_modules/", "dist/", "package-lock.json"]
}
